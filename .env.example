# Copiar a .env.local y completar. No subir .env.local al repositorio.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secreto compartido con el cron (supabase/cron.sql)
CRON_SECRET=

# WhatsApp Business Cloud API (opcional; sin estas variables los avisos se simulan)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=

# Correo alternativo (opcional; API de Resend). Sin estas variables el correo se simula.
RESEND_API_KEY=
EMAIL_FROM=
